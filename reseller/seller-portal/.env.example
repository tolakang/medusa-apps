# =====================================================================
# reseller / seller-portal — environment (seller portal)
#
# Two kinds of values:
#   BUILD-TIME  -> Dokploy: Environment > Build-time Arguments
#                  (baked into the bundle; change = rebuild)
#   RUNTIME     -> Dokploy: Environment > Environment variables
#
# The portal calls the backend from its own server only, with the seller's
# token sealed in an httpOnly cookie (TASKS P5-08), so the browser never
# calls the backend and needs no SELLER_CORS entry for this app.
# =====================================================================

# ---- BUILD-TIME ARGUMENTS ---------------------------------------------
# Public backend URL. Only a fallback when MEDUSA_BACKEND_URL is not set.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=
# This app's public URL
NEXT_PUBLIC_BASE_URL=

# ---- RUNTIME VARIABLES --------------------------------------------------
NODE_ENV=production
PORT=3000
# Backend URL used server-side: the backend's internal Dokploy hostname
# (copy the exact service name Dokploy shows), e.g. http://reseller-backend:9000
MEDUSA_BACKEND_URL=http://reseller-backend:9000
# Seals the seller's session cookie (AES-256-GCM). REQUIRED, 16+ random
# characters, e.g. `openssl rand -hex 32`. Changing it signs every seller out.
COOKIE_SECRET=CHANGE_ME
