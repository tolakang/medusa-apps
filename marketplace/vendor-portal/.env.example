# =====================================================================
# marketplace / vendor-portal — environment (vendor portal)
#
# Two kinds of values:
#   BUILD-TIME  -> Dokploy: Environment > Build-time Arguments
#                  (baked into the bundle; change = rebuild)
#   RUNTIME     -> Dokploy: Environment > Environment variables
#
# The portal calls the backend from its own server only, with the vendor's
# token sealed in an httpOnly cookie (TASKS P6-09), so the browser never
# calls the backend and needs no VENDOR_CORS entry for this app.
# =====================================================================

# ---- BUILD-TIME ARGUMENTS ---------------------------------------------
# Public backend URL. Only a fallback when MEDUSA_BACKEND_URL is not set.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=
# This app's public URL
NEXT_PUBLIC_BASE_URL=

# ---- RUNTIME VARIABLES --------------------------------------------------
NODE_ENV=production
PORT=3000
# Backend URL used server-side: the backend's internal Dokploy hostname
# (copy the exact service name Dokploy shows), e.g. http://marketplace-backend:9000
MEDUSA_BACKEND_URL=http://marketplace-backend:9000
# Seals the vendor's session cookie (AES-256-GCM). REQUIRED, 16+ random
# characters, e.g. `openssl rand -hex 32`. Changing it signs every vendor out.
COOKIE_SECRET=CHANGE_ME
# Shared secret for the backend's per-IP limits on sign-in and first-time
# setup. Must equal the backend's SHOPPER_IP_SECRET. Server only. Empty = every
# vendor counts as this server and shares one limit, so one person's wrong
# passwords can lock everyone out.
SHOPPER_IP_SECRET=
# Header with the visitor's IP. Empty = X-Real-Ip / X-Forwarded-For from
# Traefik. Behind Cloudflare's orange cloud: cf-connecting-ip.
CLIENT_IP_HEADER=
