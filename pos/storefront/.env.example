# =====================================================================
# pos / storefront — environment (online shop on the same stock, TASKS P2-09)
#
# Two kinds of values:
#   BUILD-TIME  -> Dokploy: Environment > Build-time Arguments
#                  (baked into the bundle; change = rebuild)
#   RUNTIME     -> Dokploy: Environment > Environment variables
# =====================================================================

# ---- BUILD-TIME ARGUMENTS ---------------------------------------------
# PUBLIC backend URL, e.g. https://api.example.com (used by the browser and the build; baked in)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=
# Publishable API key of the ONLINE sales channel (Admin > Settings > Publishable
# API Keys). Not a register's channel: the shop sees the products and stock
# locations of the channel this key belongs to (pos/README.md → Stock).
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# This storefront's public URL, e.g. https://shop.example.com
NEXT_PUBLIC_BASE_URL=
# Fallback country code (ISO-2 lowercase). `kh` = the Cambodia region from `pnpm seed` (backend).
NEXT_PUBLIC_DEFAULT_REGION=kh
# Stripe publishable key. Not used: Stripe is not available in Cambodia, payments
# go through ABA PayWay (decision D1, TASKS F-022). Keep empty.
NEXT_PUBLIC_STRIPE_KEY=
# CAPTCHA on sign-in, sign-up and forgot password (TASKS P1-21). Must match the
# backend's CAPTCHA_PROVIDER, or every sign-in fails. `recaptcha` = Google
# reCAPTCHA (Google Cloud, score-based key; site key = the key ID),
# `turnstile` = Cloudflare Turnstile (site key). Empty = off.
NEXT_PUBLIC_CAPTCHA_PROVIDER=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
# Hostname of product images for next/image: the host part of the backend's
# S3_FILE_URL (AWS, RustFS or SeaweedFS). Images are unoptimized (next.config.js),
# so the browser loads them straight from S3_FILE_URL; verified with SeaweedFS
# (TASKS P1-05). This only matters if image optimization is turned on.
S3_IMAGE_HOSTNAME=
# Allowed image path pattern
S3_IMAGE_PATHNAME=/**

# ---- RUNTIME VARIABLES --------------------------------------------------
NODE_ENV=production
PORT=8000
# Optional internal URL for server-side calls (starter change 6, BUILD_PLAN.md
# §4.2). Empty = server-side calls use NEXT_PUBLIC_MEDUSA_BACKEND_URL
# (src/lib/config.ts). Only set it to the backend's exact Dokploy service name
# (e.g. http://<project>-<app>-<id>:9000) after confirming it resolves.
MEDUSA_BACKEND_URL=
# Shared secret for POST /api/revalidate, which the backend calls after catalog
# changes (TASKS P1-10). Must equal the backend's REVALIDATE_SECRET. Empty = the
# route answers 404 and catalog pages refresh only every 10 minutes.
REVALIDATE_SECRET=
# Shared secret for the backend's per-IP limits on sign-in, sign-up and
# password emails (TASKS P1-21). Must equal the backend's SHOPPER_IP_SECRET.
# Server only (never NEXT_PUBLIC_). Empty = every shopper counts as this
# server and shares one limit.
SHOPPER_IP_SECRET=
# Header with the visitor's IP. Empty = X-Real-Ip / X-Forwarded-For from
# Traefik. Behind Cloudflare's orange cloud: cf-connecting-ip.
CLIENT_IP_HEADER=
