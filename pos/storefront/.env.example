# =====================================================================
# pos / storefront — environment (customer storefront)
#
# Two kinds of values:
#   BUILD-TIME  -> Dokploy: Environment > Build-time Arguments
#                  (baked into the bundle; change = rebuild)
#   RUNTIME     -> Dokploy: Environment > Environment variables
# =====================================================================

# ---- BUILD-TIME ARGUMENTS ---------------------------------------------
# Backend URL reachable DURING the build (public URL, e.g. https://api.example.com)
MEDUSA_BACKEND_URL=
# Publishable API key (Admin > Settings > Publishable API Keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# This storefront's public URL, e.g. https://shop.example.com
NEXT_PUBLIC_BASE_URL=
# Fallback country code (ISO-2 lowercase)
NEXT_PUBLIC_DEFAULT_REGION=us
# Stripe publishable key (empty if not using Stripe)
NEXT_PUBLIC_STRIPE_KEY=
# Hostname of product images (your S3/R2 bucket) for next/image
S3_IMAGE_HOSTNAME=
# Allowed image path pattern
S3_IMAGE_PATHNAME=/**

# ---- RUNTIME VARIABLES --------------------------------------------------
NODE_ENV=production
PORT=8000
# Backend URL used by the Next.js server at runtime (internal Dokploy network URL is fine)
MEDUSA_BACKEND_URL=http://pos-backend:9000
# Secret for on-demand revalidation webhooks
REVALIDATE_SECRET=CHANGE_ME
