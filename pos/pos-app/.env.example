# =====================================================================
# pos / pos-app — environment (POS counter app (web / PWA))
#
# Two kinds of values:
#   BUILD-TIME  -> Dokploy: Environment > Build-time Arguments
#                  (baked into the bundle; change = rebuild)
#   RUNTIME     -> Dokploy: Environment > Environment variables
# =====================================================================

# ---- BUILD-TIME ARGUMENTS ---------------------------------------------
# Public backend URL the browser calls, e.g. https://api.example.com
NEXT_PUBLIC_MEDUSA_BACKEND_URL=
# This app's public URL
NEXT_PUBLIC_BASE_URL=

# ---- RUNTIME VARIABLES --------------------------------------------------
NODE_ENV=production
PORT=3000
# Backend URL used server-side at runtime
MEDUSA_BACKEND_URL=http://pos-backend:9000
# Secret for this app's session cookie
COOKIE_SECRET=CHANGE_ME
