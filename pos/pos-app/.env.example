# =====================================================================
# pos / pos-app — environment (POS counter app (web / PWA), TASKS P2-10)
#
# Two kinds of values:
#   BUILD-TIME  -> Dokploy: Environment > Build-time Arguments
#                  (baked into the bundle; change = rebuild)
#   RUNTIME     -> Dokploy: Environment > Environment variables
#
# The app calls the backend from its own server only (the browser talks to
# this app's /api/pos proxy), so the backend needs no CORS entry for it.
# =====================================================================

# ---- BUILD-TIME ARGUMENTS ---------------------------------------------
# Public backend URL. Only a fallback when MEDUSA_BACKEND_URL is not set.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=
# This app's public URL (informational)
NEXT_PUBLIC_BASE_URL=

# ---- RUNTIME VARIABLES --------------------------------------------------
NODE_ENV=production
PORT=3000
# Backend URL used server-side: the backend's internal Dokploy hostname
# (copy the exact service name Dokploy shows), e.g. http://pos-backend:9000
MEDUSA_BACKEND_URL=http://pos-backend:9000
# Seals the cashier's session cookie (AES-256-GCM). REQUIRED, 16+ random
# characters, e.g. `openssl rand -hex 32`. Changing it signs every till out.
COOKIE_SECRET=CHANGE_ME
