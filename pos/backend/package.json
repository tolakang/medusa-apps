{
  "name": "pos-backend",
  "version": "0.0.1",
  "private": true,
  "description": "POS business project: Medusa backend (server + worker).",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit",
    "predeploy": "medusa db:migrate --execute-safe-links --execute-safe-search",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "seed:initial": "medusa exec ./src/scripts/seed-initial-data.ts",
    "seed:demo-products": "medusa exec ./src/scripts/seed-demo-products.ts",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=6144' jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --passWithNoTests",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/admin-shared": "2.21.2",
    "@medusajs/caching": "2.21.2",
    "@medusajs/caching-redis": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/dashboard": "2.21.2",
    "@medusajs/draft-order": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/js-sdk": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/ui": "4.2.6",
    "@tanstack/react-query": "5.64.2",
    "cors": "2.8.6",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.2",
    "@medusajs/test-utils": "2.21.2",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/cors": "2.8.19",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "jsonwebtoken": "9.0.3",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6"
  }
}
