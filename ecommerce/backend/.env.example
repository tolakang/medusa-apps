# =====================================================================
# ecommerce / backend — environment
# Dokploy: paste into the app's Environment tab (runtime variables).
# Deploy this image twice: server + worker (see bottom of file).
# Never commit real values. Generate secrets: openssl rand -base64 32
# =====================================================================

# ---- Core --------------------------------------------------------------
NODE_ENV=production
PORT=9000
# Dokploy Postgres service of THIS project only (one database per business)
DATABASE_URL=postgres://medusa:CHANGE_ME@ecommerce-postgres:5432/ecommerce
# Postgres SSL: Medusa enables SSL for any non-localhost host. Dokploy's internal
# Postgres has no SSL, so keep false. Managed DB with SSL: true. (MEDUSA_SKILL §2)
DATABASE_SSL=false
# Dokploy Redis service of THIS project only
REDIS_URL=redis://ecommerce-redis:6379
# Caching Module + caching-redis provider (replaces the deprecated cache-redis).
# Still feature-flagged in 2.21.x; required by the production config (BUILD_PLAN §4.1).
MEDUSA_FF_CACHING=true
JWT_SECRET=CHANGE_ME
COOKIE_SECRET=CHANGE_ME

# ---- CORS (comma-separated origins, no trailing slash) -----------------
# Storefront domain(s)
STORE_CORS=http://localhost:8000
# Admin dashboard domain(s)
ADMIN_CORS=http://localhost:9000
# Every client that logs in: admin, storefront
AUTH_CORS=http://localhost:9000,http://localhost:8000

# ---- Admin dashboard ---------------------------------------------------
# Empty = admin uses the browser origin (served by this backend)
MEDUSA_BACKEND_URL=
DISABLE_MEDUSA_ADMIN=false

# ---- Process role ------------------------------------------------------
# shared = one instance does everything (small setups)
# server = HTTP API + admin only   | worker = jobs, subscribers only
MEDUSA_WORKER_MODE=shared
# Run `medusa db:migrate` on start (server/shared only; always false on worker)
RUN_MIGRATIONS=true

# ---- File storage. Empty S3_BUCKET = local disk (dev only)
# Decision D3: AWS S3 or an S3-compatible server; RustFS and SeaweedFS tested
# (TASKS P1-05). One bucket per shop and environment. The bucket must allow
# anonymous read (GetObject) through a bucket policy: product image URLs are
# public. S3_FILE_URL is the public base URL that file keys are appended to.
#   AWS S3:    S3_ENDPOINT empty, S3_FORCE_PATH_STYLE=false,
#              S3_FILE_URL=https://<bucket>.s3.<region>.amazonaws.com,
#              S3_ACL=false for new buckets (Object Ownership "Bucket owner enforced")
#   RustFS:    S3_ENDPOINT=http://<rustfs-host>:9000, S3_FORCE_PATH_STYLE=true,
#              S3_FILE_URL=https://<public-rustfs-domain>/<bucket>, S3_REGION=us-east-1
#   SeaweedFS: S3_ENDPOINT=http://<seaweedfs-host>:8333, S3_FORCE_PATH_STYLE=true,
#              S3_FILE_URL=https://<public-seaweedfs-domain>/<bucket>, S3_REGION=us-east-1
# S3_ENDPOINT may be an internal hostname; S3_FILE_URL must be reachable by browsers.
# S3_ACL: empty = Medusa's default per-file ACL; false = send no ACL header
# (works on AWS with enforced ownership, RustFS, SeaweedFS); or a canned ACL.
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACL=

# Admin upload limits (TASKS P1-11, P1-12): files larger than the limit are
# rejected with a clear message before anything is stored; SVG is always
# rejected (it can carry scripts). Admins can set the limit in Settings → Store
# (stored in the store's metadata); that wins over UPLOAD_MAX_FILE_SIZE_MB
# (empty = 0.8 MB). Nothing can go above UPLOAD_MAX_FILE_SIZE_CEILING_MB (empty =
# 5), which only Dokploy can change. Set on the server (uploads never reach
# the worker). The ceiling is also the admin's own in-browser size check, which
# is baked in at build time: to change it, set UPLOAD_MAX_FILE_SIZE_CEILING_MB as
# a Build Time Argument too and rebuild (TASKS F-027).
UPLOAD_MAX_FILE_SIZE_MB=
UPLOAD_MAX_FILE_SIZE_CEILING_MB=

# ---- Notifications (Decision D2, TASKS P1-04) ---------------------------
# Empty RESEND_API_KEY / TELEGRAM_BOT_TOKEN = that channel only logs (dev).
# Set real values in Dokploy on the server AND the worker (the worker runs the
# order.placed subscriber). Never commit or paste them anywhere else.
# Resend: resend.com -> API Keys (Sending access is enough).
RESEND_API_KEY=
# Sender on a domain verified in Resend -> Domains, e.g. "My Shop <orders@example.com>".
RESEND_FROM=
# Telegram staff alerts: bot token from @BotFather; chat ID of the staff group
# (group IDs are negative, e.g. -1001234567890). Add the bot to the group first.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram order updates for customers (TASKS P1-17): a SEPARATE customer bot
# (@BotFather -> /newbot), not the staff bot. The order page shows "Get order
# updates on Telegram" only when USERNAME and WEBHOOK_SECRET are set.
# Set all three on the server AND the worker (the worker sends shipped /
# delivered / canceled updates). WEBHOOK_SECRET: 1-256 of A-Z a-z 0-9 _ -,
# e.g. openssl rand -hex 32. Then register the webhook once from the server
# terminal:
#   docker-entrypoint.sh medusa exec ./src/scripts/telegram-set-webhook.js https://<api host>/telegram/webhook
TELEGRAM_CUSTOMER_BOT_TOKEN=
TELEGRAM_CUSTOMER_BOT_USERNAME=
TELEGRAM_CUSTOMER_WEBHOOK_SECRET=

# ---- ABA PayWay payments (Decision D1, TASKS P1-03) ------------------------
# Empty MERCHANT_ID / API_KEY = PayWay is off (manual payment only).
# Set on the server AND the worker (the worker handles PayWay's callback).
# Sandbox credentials arrive by email after registering at
# https://sandbox.payway.com.kh/register-sandbox/ ; live ones come from
# paywaysales@ababank.com. Never commit or paste them anywhere else.
# PayWay only accepts calls from whitelisted domains/IPs: ask ABA to whitelist
# the shop and API domains and the server's IP ("6: wrong domain" otherwise).
# PAYWAY_API_URL: empty = sandbox (https://checkout-sandbox.payway.com.kh);
# production: https://checkout.payway.com.kh
# PAYWAY_RETURN_URL: PayWay's callback, https://<api host>/hooks/payment/payway_payway
# Uses STOREFRONT_URL (below) to send the customer back to the shop.
# Then in the admin: Settings → Regions → Cambodia → add the "payway" provider.
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_API_URL=
PAYWAY_RETURN_URL=

# ---- Storefront cache refresh (TASKS P1-10) ------------------------------
# After a product, variant, category, collection or region change, the backend
# asks the storefront to drop its cached pages (Medusa guide "Revalidate Cache
# in Next.js Starter Storefront"). Set on the server AND the worker (the worker
# runs the subscriber). REVALIDATE_SECRET must equal the storefront's.
# Empty = no refresh calls (the storefront still refreshes every 10 minutes).
# Generate: openssl rand -hex 32
# STOREFRONT_URL is also the base of the links in account emails (TASKS P1-18:
# email verification, password reset; admin.storefrontUrl): without it those
# emails are not sent. Customers must verify their email before signing in.
# Admin users' reset links use MEDUSA_BACKEND_URL, else the first ADMIN_CORS
# origin, plus /app/reset-password.
STOREFRONT_URL=
REVALIDATE_SECRET=

# ---- Ecommerce settings ------------------------------------------------
# (none yet)

# =====================================================================
# Worker app overrides (second Dokploy app, same Build Path):
#   MEDUSA_WORKER_MODE=worker
#   DISABLE_MEDUSA_ADMIN=true
#   RUN_MIGRATIONS=false
# =====================================================================
