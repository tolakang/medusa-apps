# =====================================================================
# wholesale / storefront — environment (customer storefront)
#
# Two kinds of values:
#   BUILD-TIME  -> Dokploy: Environment > Build-time Arguments
#                  (baked into the bundle; change = rebuild)
#   RUNTIME     -> Dokploy: Environment > Environment variables
# =====================================================================

# ---- BUILD-TIME ARGUMENTS ---------------------------------------------
# PUBLIC backend URL, e.g. https://api.example.com (used by the browser and the build; baked in)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=
# Publishable API key (Admin > Settings > Publishable API Keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# This storefront's public URL, e.g. https://shop.example.com
NEXT_PUBLIC_BASE_URL=
# Fallback country code (ISO-2 lowercase); it must be a country of one of your regions
NEXT_PUBLIC_DEFAULT_REGION=kh
# Stripe publishable key. Not used (payments: pay by invoice; PayWay comes with TASKS P4-12). Keep empty.
NEXT_PUBLIC_STRIPE_KEY=
# Hostname of product images (your S3/R2 bucket) for next/image
S3_IMAGE_HOSTNAME=
# Allowed image path pattern
S3_IMAGE_PATHNAME=/**
# Buyers sign in before they see the shop (BUILD_PLAN.md §6.4). Without a
# session only the sign-in / sign-up page and the legal pages open, and the
# starter's machine-readable catalog for AI agents (UCP, /buy, llms.txt,
# product Markdown, sitemap) answers 404. `false` opens the shop to guests.
# Keep it the same as the backend's WHOLESALE_REQUIRE_LOGIN, which makes the
# Store API's product, variant and search routes need a signed-in customer.
NEXT_PUBLIC_REQUIRE_LOGIN=true

# ---- RUNTIME VARIABLES --------------------------------------------------
NODE_ENV=production
PORT=8000
# Optional internal URL for server-side calls (starter change 6, BUILD_PLAN.md
# §4.2). Empty = server-side calls use NEXT_PUBLIC_MEDUSA_BACKEND_URL
# (src/lib/config.ts). Only set it to the backend's exact Dokploy service name
# (e.g. http://<project>-<app>-<id>:9000) after confirming it resolves.
MEDUSA_BACKEND_URL=
