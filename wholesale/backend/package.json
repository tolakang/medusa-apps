{
  "name": "wholesale-backend",
  "version": "0.0.1",
  "private": true,
  "description": "Wholesale (B2B) business project: Medusa backend (server + worker).",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit",
    "predeploy": "medusa db:migrate --execute-safe-links --execute-safe-search",
    "seed:initial": "medusa exec ./src/scripts/seed-initial-data.ts",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=4096' jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --passWithNoTests",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "seed:b2b": "medusa exec ./src/scripts/seed-b2b.ts"
  },
  "dependencies": {
    "@fontsource/kantumruy-pro": "5.3.0",
    "@hookform/resolvers": "5.5.7",
    "@medusajs/admin-sdk": "2.22.6",
    "@medusajs/admin-shared": "2.22.6",
    "@medusajs/caching": "2.22.6",
    "@medusajs/caching-redis": "2.22.6",
    "@medusajs/cli": "2.22.6",
    "@medusajs/dashboard": "2.22.6",
    "@medusajs/framework": "2.22.6",
    "@medusajs/icons": "2.22.6",
    "@medusajs/js-sdk": "2.22.6",
    "@medusajs/medusa": "2.22.6",
    "@medusajs/ui": "4.2.13",
    "@tanstack/react-query": "5.64.2",
    "date-fns": "4.4.0",
    "pdfmake": "0.2.23",
    "react-hook-form": "7.83.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.6",
    "@medusajs/test-utils": "2.22.6",
    "@medusajs/ui-preset": "2.22.6",
    "@swc/core": "^1.5.7",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^20.0.0",
    "@types/pdfmake": "0.2.13",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "jsonwebtoken": "9.0.3",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "scrypt-kdf": "2.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "vite": "7.3.7"
  }
}
