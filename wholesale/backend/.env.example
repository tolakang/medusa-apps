# =====================================================================
# wholesale / backend — environment
# Dokploy: paste into the app's Environment tab (runtime variables).
# Deploy this image twice: server + worker (see bottom of file).
# Never commit real values. Generate secrets: openssl rand -base64 32
# =====================================================================

# ---- Core --------------------------------------------------------------
NODE_ENV=production
PORT=9000
# Dokploy Postgres service of THIS project only (one database per business)
DATABASE_URL=postgres://medusa:CHANGE_ME@wholesale-postgres:5432/wholesale
# Postgres SSL: Medusa enables SSL for any non-localhost host. Dokploy's internal
# Postgres has no SSL, so keep false. Managed DB with SSL: true. (MEDUSA_SKILL §2)
DATABASE_SSL=false
# Dokploy Redis service of THIS project only
REDIS_URL=redis://wholesale-redis:6379
# Caching Module + caching-redis provider (replaces the deprecated cache-redis).
# Feature-flagged; required by the production config (BUILD_PLAN §4.1).
MEDUSA_FF_CACHING=true
JWT_SECRET=CHANGE_ME
COOKIE_SECRET=CHANGE_ME
# Local http only (a local compose stack sets false so the admin can sign in
# on http://localhost). Leave unset on Dokploy: the admin session cookie must
# stay Secure over HTTPS.
# SESSION_COOKIE_SECURE=

# ---- CORS (comma-separated origins, no trailing slash) -----------------
# Storefront domain(s)
STORE_CORS=http://localhost:8000
# Admin dashboard domain(s)
ADMIN_CORS=http://localhost:9000
# Every client that logs in: admin, storefront
AUTH_CORS=http://localhost:9000,http://localhost:8000

# ---- Admin dashboard ---------------------------------------------------
# Empty = admin uses the browser origin (served by this backend)
MEDUSA_BACKEND_URL=
DISABLE_MEDUSA_ADMIN=false

# ---- Process role ------------------------------------------------------
# shared = one instance does everything (small setups)
# server = HTTP API + admin only   | worker = jobs, subscribers only
MEDUSA_WORKER_MODE=shared
# Run `medusa db:migrate` on start (server/shared only; always false on worker)
RUN_MIGRATIONS=true

# ---- File storage. Empty S3_BUCKET = local disk (dev only)
# Decision D3: AWS S3 (TASKS.md decisions log). For AWS leave S3_ENDPOINT
# empty and S3_FORCE_PATH_STYLE=false; both are only needed for R2/MinIO.
# S3_FILE_URL is the public base URL of the bucket, e.g.
#   https://<bucket>.s3.<region>.amazonaws.com
# The same host goes into the storefront's S3_IMAGE_HOSTNAME (next/image).
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# S3_ACL: empty = Medusa's default per-file ACL; false = send no ACL header
# (AWS buckets with Object Ownership "Bucket owner enforced", F-025)
S3_ACL=

# ---- Storefront ----------------------------------------------------------
# Public storefront URL: base of the links in account emails (password reset).
STOREFRONT_URL=

# ---- Wholesale settings ------------------------------------------------
# true: a company that signs up in the storefront starts as "pending" and
# can't order until you set it to "approved" in the admin (TASKS P4-07).
# Unset or false: sign-ups are approved at once.
WHOLESALE_REQUIRE_APPROVAL=true

# true (or unset): the Store API's product, variant and search routes need a
# signed-in customer, so nobody reads products or prices with only the
# publishable key (TASKS F-068). Set false only together with the
# storefront's NEXT_PUBLIC_REQUIRE_LOGIN=false (a shop open to guests).
WHOLESALE_REQUIRE_LOGIN=true

# Invoice PDF seller block (TASKS P4-06). Use \n for new lines.
INVOICE_SELLER_NAME=
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_TAX_ID=
INVOICE_SELLER_EMAIL=
INVOICE_SELLER_PHONE=
# Printed under the totals, e.g. bank details for net-terms invoices
INVOICE_PAYMENT_NOTE=

# =====================================================================
# Worker app overrides (second Dokploy app, same Build Path):
#   MEDUSA_WORKER_MODE=worker
#   DISABLE_MEDUSA_ADMIN=true
#   RUN_MIGRATIONS=false
# =====================================================================
